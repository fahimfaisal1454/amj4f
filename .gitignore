# ==========================================
# Node / React Frontend .gitignore
# ==========================================

# --- Node dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build output ---
/build
/dist
/.parcel-cache
/.next
/out
/.vite
/.cache

# --- Local environment files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Logs ---
logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
.DS_Store
Thumbs.db

# --- Testing ---
coverage/
*.lcov

# --- Misc cache / temp ---
.tmp/
temp/
.cache-loader/
.eslintcache
.stylelintcache
__pycache__/
*.pid

# --- System / OS files ---
.DS_Store
Icon?
ehthumbs.db
Desktop.ini

# --- Storybook / Preview ---
.storybook-out/
storybook-static/

# --- Optional: Lockfiles (if team uses single package manager) ---
# Uncomment ONE if you prefer to ignore others
# yarn.lock
# package-lock.json
# pnpm-lock.yaml

# --- Local custom ---
# Ignore any secrets, API keys, etc.
secret.*
private/
local_config.js

# --- Images / Uploads (if not tracked) ---
/public/uploads/
/src/assets/uploads/
